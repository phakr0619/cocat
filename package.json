{
  "name": "ai-chem-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "samples": "vitest run tests/io.test.ts tests/structures.test.ts tests/table.test.ts tests/cdx.test.ts tests/salt.test.ts tests/stereoGroups.test.ts tests/abbrLabels.test.ts",
    "verify:cdxml": "npm run samples && .venv/bin/python tools/verify_cdxml.py out/*.cdxml out/*.cdx out/structures/*.cdxml out/abbr-labels/*.cdxml",
    "eval:llm": "vitest run --config tests/llm-eval/vitest.config.ts",
    "eval:llm-edit": "vitest run --config tests/llm-eval/vitest.edit.config.ts",
    "eval:llm-image": "vitest run --config tests/llm-eval/vitest.image.config.ts",
    "eval:llm-figures": "vitest run --config tests/llm-eval/vitest.figures.config.ts",
    "eval:llm-pdf": "vitest run --config tests/llm-eval/vitest.pdf.config.ts",
    "eval:llm-finish": "vitest run --config tests/llm-eval/vitest.finish.config.ts",
    "eval:llm-writeup": "vitest run --config tests/llm-eval/vitest.writeup.config.ts",
    "eval:llm-name": "vitest run --config tests/llm-eval/vitest.name.config.ts",
    "fetch:real-papers": "node scripts/fetch-real-papers.mjs",
    "eval:llm-real": "vitest run --config tests/llm-eval/vitest.real.config.ts",
    "eval:llm-si": "vitest run --config tests/llm-eval/vitest.si.config.ts"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2026.9.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
